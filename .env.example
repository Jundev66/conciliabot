# --- Despliegue por cliente (docker compose) -------------------------------
# Copia este archivo a .env y ajusta lo que necesites. Compose lo lee solo.

# Direccion publica del sitio tras Caddy (IP o hostname del servidor).
# Para un dominio real con HTTPS, edita Caddyfile (quita la linea "tls internal").
SITE_ADDRESS=localhost

# --- Seguridad ------------------------------------------------------------
CONCILIABOT_AUTH=on
# CONCILIABOT_AUTH_TOKEN=            # vacio -> se genera en backend/data/api_token
# CONCILIABOT_DB_KEY=                # base64 de 16/24/32 bytes: cifra secretos y documentos
CONCILIABOT_ALLOW_PRIVATE=on
CONCILIABOT_RATE_LIMIT=60
CONCILIABOT_DOCUMENT_RETENTION_DAYS=90

# Mock del ERP web (solo para demo). Ponlo en off contra tu ERP real.
CONCILIABOT_WEBMOCK=on

# --- ERP real (CoreBiz) ---------------------------------------------------
# Tambien puedes configurarlo en la UI: Configuracion -> Conexion al ERP.
# CONCILIABOT_ERP_PROVIDER=corebiz
# COREBIZ_BASE_URL=https://api.corebiz.tu-dominio.com
# COREBIZ_API_KEY=
# COREBIZ_TENANT_ID=

# --- LLM opcional (si no, el agente corre offline con heuristica) ---------
# CONCILIABOT_LLM=on
# CONCILIABOT_LLM_BASE_URL=
# CONCILIABOT_LLM_API_KEY=
